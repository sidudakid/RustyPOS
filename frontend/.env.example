# Local desktop dev
# VITE_API_BASE=http://127.0.0.1:8081
# VITE_PUBLIC_ORIGIN=http://127.0.0.1:4173

# LAN/mobile dev example
# VITE_API_BASE=http://192.168.1.81:8081
# VITE_PUBLIC_ORIGIN=http://192.168.1.81:4173

# Production example
# VITE_API_BASE=https://api.your-domain.com
# VITE_PUBLIC_ORIGIN=https://your-domain.com

# If VITE_API_BASE is unset, frontend will default to http://<current-browser-host>:8081
# If VITE_PUBLIC_ORIGIN is unset, generated customer links/QRs will use the current browser origin.
